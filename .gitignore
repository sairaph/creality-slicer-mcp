# Local notes, plans, reference sources and printer snapshots
/references/
/dev_docs/

# Go build output
/creality-slicer-mcp
/creality-slicer-mcp.exe
/dist/

# Project-scoped registry written by `creality-slicer-mcp add`
/.creality-slicer-mcp/

# tools/catalog-gen writes its full catalog (with Creality's AGPL tooltip text)
# to ./settings-catalog-<ref>.json by default; only the slim catalog is committed.
/tools/catalog-gen/settings-catalog-*.json
/tools/catalog-gen/diff*.json
/tools/catalog-gen/*.exe

# Go test binaries
*.test.exe
*.test
